# ByteSize in Docker: copy to .env next to docker-compose.yml and change these values.

# Database (the db container is created with these)
POSTGRES_USER=bytesize
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bytesize

# A long random string (at least 32 characters); signs logins and encrypts saved AI keys.
# Make one: openssl rand -base64 48
JWT_SECRET=

# Port on this server (http://<server>:4100). Change it if 4100 is taken; the app inside the container stays on 4100.
PORT=4100

# Behind a reverse proxy (Traefik, Nginx Proxy Manager, Caddy): set this to the address ByteSize sees your proxy
# connect from, so sign-in lockouts and rate limits work per person. Only that address's X-Forwarded-For is
# believed; by default only this machine is. Use the proxy's IP or its Docker network (e.g. 172.20.0.0/16), never
# your whole LAN: anything trusted here can claim to be any address. Several: separate with commas.
# Find the proxy's Docker IP: docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' <proxy>
# TRUST_PROXY=172.20.0.2

# Passkeys work on https:// addresses and localhost, with no setup. Optional: only allow these addresses:
# PASSKEY_ORIGINS=https://bytesize.example.com

# iPhone app passkeys: your Apple Team ID and the app's bundle ID (serves /.well-known/apple-app-site-association)
# IOS_APP_ID=ABCDE12345.com.cwland.bytesize

# Your time zone (e.g. America/Chicago, Europe/London)
TZ=America/Denver

# Daily backup of the whole server into ./data/app/backups (see README › Backups)
# The hour (server time, 0-23) after which the day's backup is made
# BACKUP_HOUR=3
# How many backups to keep (0 turns the daily backup off)
# BACKUP_KEEP=14

# Email (optional): used when nothing is saved in Settings › Email (admin), which is the easier place to set it up.
# Sends the 6-digit codes for Forgot password on the sign-in screen.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# true for SSL/TLS from the start (port 465); by default only port 465 uses it
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=you@gmail.com
# ByteSize's own address, used in emails
# APP_URL=https://bytesize.example.com

# Locked out by OAuth (Settings › Security › OAuth only)? Set this, restart, sign in with your password, then
# remove it. It turns OAuth only and OAuth sign-in off at every start (same as: npm run auth:reset).
# EMERGENCY_DISABLE_OAUTH=true
