# ByteSize in Docker: copy to .env next to docker-compose.yml and change these values.

# Database (the db container is created with these)
POSTGRES_USER=bytesize
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bytesize

# A long random string (at least 32 characters); signs logins and encrypts saved AI keys.
# Make one: openssl rand -base64 48
JWT_SECRET=

# Port on this server (http://<server>:4100). Change it if 4100 is taken; the app inside the container stays on 4100.
PORT=4100

# Behind a reverse proxy (Traefik, Nginx Proxy Manager, Caddy): the proxy's address is trusted for
# X-Forwarded-For / X-Forwarded-Proto. The default trusts private networks (Docker, your LAN).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Passkeys work on https:// addresses and localhost, with no setup. Optional: only allow these addresses:
# PASSKEY_ORIGINS=https://bytesize.example.com

# Your time zone (e.g. America/Chicago, Europe/London)
TZ=America/Boise

# Daily backup of the whole server into ./data/app/backups (see README › Backups)
# The hour (server time, 0-23) after which the day's backup is made
# BACKUP_HOUR=3
# How many backups to keep (0 turns the daily backup off)
# BACKUP_KEEP=14
