DATABASE_URL=postgresql://bytesize:bytesize@localhost:5432/bytesize
TEST_DATABASE_URL=postgresql://bytesize:bytesize@localhost:5432/bytesize_test
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
PORT=4100

# Email (optional): used when nothing is saved in Settings › Email (admin), which is the easier place to set it up.
# Sends the 6-digit codes for Forgot password on the sign-in screen.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# true for SSL/TLS from the start (port 465); by default only port 465 uses it
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=you@gmail.com
# ByteSize's own address, used in emails
# APP_URL=https://bytesize.example.com

# Locked out by OAuth (Settings › Security › OAuth only)? Set this, restart, sign in with your password, then
# remove it. It turns OAuth only and OAuth sign-in off at every start (same as: npm run auth:reset).
# EMERGENCY_DISABLE_OAUTH=true
